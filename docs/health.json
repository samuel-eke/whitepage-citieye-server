  "complianceGuide": {
    "NDPR": "Nigerian Data Protection Regulation",
    "sensitiveDataHandling": {
      "consentRequired": true,
      "minimalRetention": "12 months maximum for sensitive fields (health diagnosis, mental health, substance use, reproductive health, abuse history)",
      "restrictedAccess": "Only assigned health officers + health facility staff; never shared with education, HR, or other domains without explicit consent",
      "purposeUse": "Data used only for health interventions and service delivery; no surveillance, profiling, or commercial use",
      "studentBriefing": "Transparently explain why data is collected (e.g., 'helps us match you with mental health support if you need it')"
    },
    "mandatoryReporting": {
      "childAbuse": "Immediate referral to Federal Ministry of Women Affairs & Community Development (FMWAC)",
      "trafficking": "Immediate referral to FMWAC + police",
      "childLabor": "Referral to labor inspection + social services",
      "suicidalIdeation": "Immediate crisis assessment + 24/7 hotline",
      "domesticViolence": "Referral to victim support services + legal authorities",
      "maternalComplications": "Urgent obstetric referral"
    }
  },
  "interventionTriggers": {
    "malnutrition": {
      "trigger": "h0_014.anySignPresent = true OR (h0_013.weightKg < -2 SD for age)",
      "service": "Emergency nutrition support, caregiver education, growth monitoring"
    },
    "lowBirthWeight": {
      "trigger": "h0_012.weightKg < 2.5",
      "service": "Early intervention program, developmental monitoring, specialist referral if needed"
    },
    "vaccineGap": {
      "trigger": "h0_007.isUptodate = false OR h6_003 = false",
      "service": "Catch-up immunization program, defaulter tracking"
    },
    "developmentalDelay": {
      "trigger": "h0_025.isMet = false OR h0_026.hasConcerns = true",
      "service": "Early childhood development assessment, specialist referral"
    },
    "depressionAnxiety": {
      "trigger": "h12_010.hasSymptoms = true",
      "service": "PHQ-9 screening, mental health counseling, NMHP program enrollment"
    },
    "suicidalCrisis": {
      "trigger": "h12_011 = true",
      "service": "Immediate crisis assessment, 24/7 hotline, hospitalization if needed"
    },
    "adolescentPregnancy": {
      "trigger": "h12_008.hasExperienced = true",
      "service": "Antenatal care enrollment, social support, schooling continuation support, child protection assessment"
    },
    "childLabor": {
      "trigger": "socioeconomic context + working hours excessive",
      "service": "Labor inspection, income support for family, education continuation support"
    },
    "chronicDisease": {
      "trigger": "h12_023.hasCondition = true OR h6_011.hasCondition = true",
      "service": "Chronic disease registry, specialist referral, disease management program"
    },
    "disabilityScreening": {
      "trigger": "h6_015 = false OR h6_016 = false OR h12_024.hasDisability = true",
      "service": "Assistive device provision, specialist referral, school accommodation plan"
    }
  }
